<?xml version="1.0"?>
<package format="3">
  <name>wheel_defect_demo</name>
  <version>0.1.0</version>
  <description>Wheel defect detection and compensation demo for AIONIS robot</description>
  <maintainer email="andrei@aionis.ro">Andrei</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>dummybot_bringup</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>