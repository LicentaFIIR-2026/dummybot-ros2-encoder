<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sas_bringup</name>
  <version>0.1.0</version>
  <description>Master bringup pentru Semantic Autonomy Stack pe SAIM Xplorer / AIONIS.</description>
  <maintainer email="andrei@upb.ro">Andrei</maintainer>
  <license>MIT</license>

  <exec_depend>semantic_localizer</exec_depend>
  <exec_depend>nav2_route</exec_depend>
  <exec_depend>xplorer_mcp_bridge</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ros2lifecycle</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>